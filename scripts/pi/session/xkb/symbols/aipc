// ปุ่ม ` (ซ้ายของเลข 1) สลับไทย/อังกฤษ แบบ Windows · Pakon เลือก 2026-09-24
// ตัวเลือกมาตรฐานของ xkb ไม่มีปุ่มนี้ จึงเขียนเอง · แต่ละส่วนใช้กับผังแป้นเดียว (ดู rules/evdev)
// กด Shift ค้าง = ตัวเดิมของปุ่ม (อังกฤษ ~ · ไทย %) · ตัว ` เองพิมพ์ไม่ได้ เหมือนบน Windows
partial alphanumeric_keys
xkb_symbols "grave_toggle_latin" {
    key <TLDE> { [ ISO_Next_Group, asciitilde ] };
};

partial alphanumeric_keys
xkb_symbols "grave_toggle_thai" {
    key <TLDE> { [ ISO_Next_Group, percent ] };
};

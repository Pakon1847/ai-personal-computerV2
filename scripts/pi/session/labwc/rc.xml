<?xml version="1.0" encoding="UTF-8"?>
<!--
  ค่าตั้ง labwc ของเซสชัน V2 (การ์ด 0004)
  มีคีย์ลัดแค่สลับหน้าต่าง (กลับจากเบราว์เซอร์ที่สกิล 4 เปิด) และ F9 / Alt+Space สั่งด้วยเสียง (การ์ด 0024 · 0026) · ไม่มีคีย์เปิด terminal/เมนู/ปิดเครื่องของ Pi
  labwc โหลดคีย์ลัดค่าเริ่มต้นเฉพาะเมื่อไม่ได้กำหนดเลย หรือใส่ <default /> → ที่นี่กำหนดเอง จึงไม่มีค่าเริ่มต้น
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>PiXtrix</name>
    <titlebar>
      <layout>:iconify,max,close</layout>
    </titlebar>
  </theme>

  <keyboard>
    <numlock>off</numlock>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <!-- F9 = เริ่ม/หยุดฟังเสียง ใช้ได้แม้เบราว์เซอร์เต็มจอ (การ์ด 0024 · Pakon เลือกปุ่มเดียวแทนคำปลุก 2026-10-13) -->
    <keybind key="F9">
      <action name="Execute" command="/opt/aipc-v2/scripts/pi/session/aipc-voice-key" />
    </keybind>
    <!-- Alt+Space = ปุ่มเดียวกับ F9 สำหรับคีย์บอร์ดที่ไม่มี F9 (การ์ด 0026 · Pakon 2026-10-14) · labwc ผูกปุ่มเดียวกันซ้ำไม่ได้ แต่ต่างปุ่มได้ -->
    <keybind key="A-space">
      <action name="Execute" command="/opt/aipc-v2/scripts/pi/session/aipc-voice-key" />
    </keybind>
  </keyboard>

  <!--
    ความเร็วเมาส์: ค่าเริ่มต้นของ libinput (0.0) ช้าเกินไปบนจอ 1920×1080 กับเมาส์ไร้สายที่ใช้ทดสอบ
    (Pakon แจ้ง 2026-09-24) · ช่วง -1.0 ถึง 1.0 · adaptive = ขยับเร็วแล้วไปไกลขึ้น
    ภายหลังควรย้ายไปให้ผู้ใช้ปรับเองในหน้าตั้งค่า (ต้องมีการ์ดออกแบบ)
  -->
  <libinput>
    <device category="non-touch">
      <pointerSpeed>0.6</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>

  <mouse>
    <!-- คลิกที่หน้าต่าง = เลือกหน้าต่างนั้น · ไม่มีเมนูคลิกขวาบนพื้นหลัง -->
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move" /></mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Click"><action name="Iconify" /></mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleMaximize" /></mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click"><action name="Close" /></mousebind>
    </context>
  </mouse>
</openbox_config>

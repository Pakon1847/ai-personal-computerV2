#!/bin/sh
# เริ่ม llama-server ของผู้ใช้คนนี้ (การ์ด 0013) · systemd user service aipc-llm.service เรียกไฟล์นี้
# ค่าตั้งมาจาก /etc/aipc/llm.conf (ผู้ดูแลแก้): MODEL= THREADS= CTX= TEMPLATE=
# คุยผ่าน Unix socket ใน $XDG_RUNTIME_DIR/aipc (0700 ของผู้ใช้คนนี้) · ไม่เปิดพอร์ตเครือข่าย (ADR-008)
# --no-webui --no-slots = ปิดหน้าเว็บในตัวและหน้าดูสถานะ slot (ไม่ให้เห็นบทสนทนาผ่าน API)
# FLASH_ATTN = off เป็นค่าเริ่มต้น: Pi 5 (Typhoon 4B · 3 thread) คำขอยาว 2,048 token สร้างได้ 3.68 tok/s เมื่อปิด
#   แต่เปิด (ค่า auto ของ llama-server) เหลือ 2.01 · คำขอว่างเท่ากัน (docs/benchmarks/2026-09-30-flash-attn-pi5)
# CACHE_RAM = แคชคำขอเก่าใน RAM (MiB) · ค่าเริ่มต้นของ llama-server 8192 = เท่า RAM ทั้งเครื่อง · Pi 5 2026-09-30:
#   ใช้คำขอยาวต่อกันราว 2 ชม. แล้วโดน OOM kill (anon 6.1 GB) · service นี้จำกัด 4G จึงตั้ง 512
# TEMPLATE = chat template ต้นฉบับของโมเดล (scripts/pi/chat-templates) · ตัวที่ฝังใน GGUF บางตัวไม่มี tool calling
set -eu
. /etc/aipc/llm.conf
: "${MODEL:?ไม่มี MODEL ใน /etc/aipc/llm.conf}"
DIR="${XDG_RUNTIME_DIR:?ไม่มี XDG_RUNTIME_DIR}/aipc"
mkdir -p "$DIR"
chmod 0700 "$DIR"
rm -f "$DIR/llm.sock"   # socket ค้างจากรอบที่แล้ว (ล่ม) ทำให้เริ่มใหม่ไม่ได้
export LD_LIBRARY_PATH=/opt/aipc-llm/lib
if [ -n "${TEMPLATE:-}" ]; then
  exec /opt/aipc-llm/bin/llama-server -m "$MODEL" --chat-template-file "$TEMPLATE" --host "$DIR/llm.sock" \
    -c "${CTX:-4096}" -t "${THREADS:-4}" -fa "${FLASH_ATTN:-off}" -cram "${CACHE_RAM:-512}" --no-webui --no-slots
fi
exec /opt/aipc-llm/bin/llama-server -m "$MODEL" --host "$DIR/llm.sock" \
  -c "${CTX:-4096}" -t "${THREADS:-4}" -fa "${FLASH_ATTN:-off}" -cram "${CACHE_RAM:-512}" --no-webui --no-slots

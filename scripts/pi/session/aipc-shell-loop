#!/usr/bin/env bash
# เปิดหน้าจอ V2 และเปิดใหม่เมื่อล่ม (การ์ด 0004, H2)
#
# - หน้าจอ V2 จบเอง (ล่ม หรือผู้ใช้ปิดหน้าต่าง) → เปิดใหม่
# - ล่มครบ AIPC_MAX_CRASHES ครั้ง ภายใน AIPC_CRASH_WINDOW วินาที → เลิก · labwc (-S) จบตาม
#   → greetd กลับหน้า Login (ไม่ปล่อยจอดำค้าง)
# - labwc จบแล้ว (ผู้ใช้กด "ออก") → เลิกทันที ไม่เปิดใหม่
# ค่าที่เปลี่ยนได้ (ใช้ในเทสต์): AIPC_SHELL_CMD AIPC_MAX_CRASHES AIPC_CRASH_WINDOW
set -u
HERE="$(dirname "$(readlink -f "$0")")"
APP="$(cd "$HERE/../../.." && pwd)"
CMD="${AIPC_SHELL_CMD:-$APP/.venv/bin/python -m aipc.ui --session --fullscreen}"
MAX="${AIPC_MAX_CRASHES:-3}"
WINDOW="${AIPC_CRASH_WINDOW:-60}"

log() {
  printf 'aipc-session: %s\n' "$*" >&2
  logger -t aipc-session -- "$*" 2>/dev/null || true
}
# labwc ตั้ง LABWC_PID ให้โปรแกรมที่มันเปิด · ไม่มีค่า (เช่นในเทสต์) = ถือว่ายังอยู่
# โปรเซสที่จบแล้วแต่ยังไม่ถูกเก็บ (zombie, สถานะ Z) kill -0 ยังผ่าน → ต้องดูสถานะด้วย
labwc_alive() {
  [ -z "${LABWC_PID:-}" ] && return 0
  local st
  st="$(ps -o stat= -p "$LABWC_PID" 2>/dev/null)" || return 1
  [ -n "$st" ] && [ "${st:0:1}" != "Z" ]
}

# รุ่นที่เซสชันนี้เริ่มถูกลบไประหว่างใช้ (อัปเดตแอป · พบบน Pi 5 2026-10-01: เปิดใหม่ได้รหัส 127 สองครั้ง
# แล้วเด้งกลับหน้า Login) → เปิดจากรุ่นปัจจุบัน /opt/aipc-v2 แทน
CURRENT="${AIPC_CURRENT_APP:-/opt/aipc-v2}"

# หน้า "กำลังเปิด…" ระหว่างรอแอปโหลด (~4 วิ · เดิมจอดำหลังสแกนหน้าผ่าน · Pakon 2026-10-23) ·
# ภาพมาจากแอปรอบก่อน (aipc.ui.splash) · ยังไม่มี = สีพื้นของธีม · swaybg ไม่มี = เหมือนเดิม ·
# เป็นพื้นหลังของ labwc: หน้าต่างแอปเต็มจอทับเอง · แอปล่มแล้วเปิดใหม่ก็เห็นภาพนี้แทนจอดำ
if command -v swaybg >/dev/null 2>&1; then
  SPLASH="${XDG_CACHE_HOME:-$HOME/.cache}/aipc/splash.png"
  if [ -s "$SPLASH" ]; then
    swaybg -m fill -i "$SPLASH" >/dev/null 2>&1 &
  elif grep -qs '"theme": *"light"' "${XDG_CONFIG_HOME:-$HOME/.config}/aipc/ui.json"; then
    swaybg -c '#F6F7F9' >/dev/null 2>&1 &
  else
    swaybg -c '#050506' >/dev/null 2>&1 &
  fi
fi
recent=""   # เวลาที่ล่มในช่วง WINDOW วินาทีล่าสุด คั่นด้วยช่องว่าง
while labwc_alive; do
  if [ -z "${AIPC_SHELL_CMD:-}" ] && [ ! -x "$APP/.venv/bin/python" ] && [ -x "$CURRENT/.venv/bin/python" ]; then
    log "รุ่นเดิม ($APP) ถูกลบแล้ว · เปิดจากรุ่นปัจจุบัน"
    APP="$(readlink -f "$CURRENT")"
    CMD="$APP/.venv/bin/python -m aipc.ui --session --fullscreen"
  fi
  $CMD
  code=$?
  labwc_alive || break
  now="$(date +%s)"
  kept=""
  for t in $recent; do
    [ $((now - t)) -lt "$WINDOW" ] && kept="$kept $t"
  done
  recent="$kept $now"
  n=$(wc -w <<<"$recent")
  if [ "$n" -ge "$MAX" ]; then
    log "หน้าจอ V2 ล่ม $n ครั้งใน $WINDOW วินาที (ครั้งล่าสุดรหัส $code) · จบเซสชัน กลับหน้า Login"
    exit 1
  fi
  log "หน้าจอ V2 จบด้วยรหัส $code · เปิดใหม่ (ครั้งที่ $n)"
  sleep 1
done
exit 0
